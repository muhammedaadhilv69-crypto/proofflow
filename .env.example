# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
# Must be an absolute https URL in production. Review links, password reset
# emails, workspace invitations, robots.txt, and sitemap.xml are all built from
# this value, and the app refuses to start if it points at localhost over http.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend example)
# If these are unset, emails are skipped and the affected UI surfaces a link to
# share manually instead of failing.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# Error monitoring (Sentry)
# Two separate jobs, two separate credentials.
#
# 1. Error reporting (runtime). SENTRY_DSN covers server-side; the browser
#    bundle can only read NEXT_PUBLIC_* vars, so set it too or client errors
#    will be silently dropped. Both come from Project Settings > Client Keys (DSN).
# 2. Source map upload (build time). Only needed for CI/deploys so Sentry can
#    symbolicate minified stack traces. The auth token is a one-time secret
#    from Settings > API > Auth Tokens, with scopes org:read + project:releases.
#    When these are absent the build skips the upload instead of failing.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics (PostHog)
# Disabled entirely when the key is empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Demo seed only. Never set these in a production environment.
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=change-this-demo-password
SEED_DEMO_WORKSPACE=A Mad Dev
SEED_DEMO_PRINT_REVIEW_LINK=false
